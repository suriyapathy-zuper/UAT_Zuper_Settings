<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  UAT-ZuperSettings Sanity Suite
  Same classes as testng.xml, only the @Test methods in the "sanity" group
  (login, module navigation, create and delete). Same single browser session / Dashboard flow.
  Run: mvn test -Dsuite.file=testng_sanity.xml
-->
<suite name="UAT-ZuperSettings Sanity Suite" parallel="none" preserve-order="true" verbose="2">
  <listeners>
    <listener class-name="TestUtility.TestExecutionListener"/>
  </listeners>
  <test name="Settings Sanity Tests" preserve-order="true">
    <groups>
      <run>
        <include name="sanity"/>
      </run>
    </groups>
    <classes>
      <class name="RunnerClass.TC_Company_Login"/>
      <class name="RunnerClass.TC_Settings_UserManagement"/>
      <class name="RunnerClass.TC_Job_Category"/>
      <class name="RunnerClass.TC_Job_Card_Template"/>
      <class name="RunnerClass.TC_Inspection_Form"/>
      <class name="RunnerClass.TC_Job_Notification"/>
      <class name="RunnerClass.TC_Gallery"/>
      <class name="RunnerClass.TC_Custom_Fields"/>
    </classes>
  </test>
</suite>
