<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  UAT-ZuperSettings Regression Suite
  All existing TestNG automation classes, executed sequentially in the order listed.
  One browser session for the whole suite (TestExecutionListener -> SuiteSession):
  launch + company login once before the first class, logout + close once after the last class.
  Every class starts from the Dashboard and returns to the Dashboard when it finishes.
  Run: mvn test                      (this file)
       mvn test -Dsuite.file=testng_sanity.xml
-->
<suite name="UAT-ZuperSettings Regression Suite" parallel="none" preserve-order="true" verbose="2">
  <listeners>
    <listener class-name="TestUtility.TestExecutionListener"/>
  </listeners>
  <test name="Settings Regression Tests" preserve-order="true">
    <groups>
      <run>
        <include name="regression"/>
      </run>
    </groups>
    <classes>
      <class name="RunnerClass.TC_Company_Login"/>
      <class name="RunnerClass.TC_Settings_UserManagement"/>
      <class name="RunnerClass.TC_Settings_SideMenu_Navigation"/>
      <class name="RunnerClass.TC_Job_Category"/>
      <class name="RunnerClass.TC_Job_Card_Template"/>
      <class name="RunnerClass.TC_Inspection_Form"/>
      <class name="RunnerClass.TC_Job_Notification"/>
      <class name="RunnerClass.TC_Gallery"/>
      <class name="RunnerClass.TC_Custom_Fields"/>
    </classes>
  </test>
  
  
</suite>
<!-- This is a single-line comment -->